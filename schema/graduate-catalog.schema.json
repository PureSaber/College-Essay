{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PureSaber/College-Essay/blob/main/schema/graduate-catalog.schema.json",
  "title": "Graduate application essay curated source catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "last_updated",
    "scope",
    "records"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regions",
        "priority_universities",
        "degree_levels",
        "programme_types",
        "full_text_policy"
      ],
      "properties": {
        "regions": {
          "type": "array",
          "items": {
            "enum": [
              "Hong Kong",
              "Singapore"
            ]
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "priority_universities": {
          "type": "array",
          "items": {
            "enum": [
              "HKU",
              "HKUST",
              "CUHK",
              "NUS",
              "NTU"
            ]
          },
          "minItems": 5,
          "uniqueItems": true
        },
        "degree_levels": {
          "type": "array",
          "items": {
            "const": "graduate"
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "programme_types": {
          "type": "array",
          "items": {
            "enum": [
              "coursework_master",
              "research_master",
              "phd",
              "mba_or_executive",
              "mixed_research_postgraduate",
              "multiple_programmes"
            ]
          },
          "minItems": 6,
          "uniqueItems": true
        },
        "full_text_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_type",
        "universities",
        "primary_university",
        "region",
        "degree_level",
        "programme_type",
        "application_route",
        "program",
        "cycle",
        "requirement_status",
        "outcome",
        "scholarship",
        "evidence_tier",
        "quality_score",
        "featured",
        "document_types",
        "source",
        "copyright",
        "summary_zh",
        "strengths",
        "limitations",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "record_type": {
          "enum": [
            "official_requirement",
            "official_guidance",
            "official_exception",
            "admitted_case",
            "community_case"
          ]
        },
        "universities": {
          "type": "array",
          "items": {
            "enum": [
              "HKU",
              "HKUST",
              "CUHK",
              "NUS",
              "NTU"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "primary_university": {
          "enum": [
            "HKU",
            "HKUST",
            "CUHK",
            "NUS",
            "NTU"
          ]
        },
        "region": {
          "enum": [
            "Hong Kong",
            "Singapore"
          ]
        },
        "degree_level": {
          "const": "graduate"
        },
        "programme_type": {
          "enum": [
            "coursework_master",
            "research_master",
            "phd",
            "mba_or_executive",
            "mixed_research_postgraduate",
            "multiple_programmes"
          ]
        },
        "application_route": {
          "type": "string",
          "minLength": 1
        },
        "program": {
          "$ref": "#/$defs/nullableString"
        },
        "cycle": {
          "$ref": "#/$defs/nullableString"
        },
        "requirement_status": {
          "enum": [
            "current",
            "cycle_specific",
            "historical",
            "not_applicable"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/nullableString"
        },
        "scholarship": {
          "$ref": "#/$defs/nullableString"
        },
        "evidence_tier": {
          "enum": [
            "A",
            "A-",
            "B+",
            "B",
            "C+",
            "C",
            "D+",
            "D"
          ]
        },
        "quality_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "featured": {
          "type": "boolean"
        },
        "document_types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "url",
            "platform",
            "source_type",
            "published_at"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "source_type": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "published_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            }
          }
        },
        "copyright": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "full_text_in_repo",
            "policy",
            "license"
          ],
          "properties": {
            "full_text_in_repo": {
              "type": "boolean"
            },
            "policy": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "summary_zh": {
          "type": "string",
          "minLength": 20
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
